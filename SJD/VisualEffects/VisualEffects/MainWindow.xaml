<Window x:Class="VisualEffects.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisualEffects"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Click Me" Width="100" Height="30" Margin="0,0,0,10"/>
            <Button Width="70" Height="50" Margin="0,0,0,10" Background="CornflowerBlue" RenderTransformOrigin="0.5,0.5">
                <Button.LayoutTransform>
                    <TransformGroup>
                        <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.2" ScaleY="1.2"/>
                        <RotateTransform CenterX="0.5" CenterY="0.5" Angle="45"/>
                    </TransformGroup>
                </Button.LayoutTransform>
                <Button.Content>
                    <Button Height="30" Width="40">
                        <Button.LayoutTransform>
                            <RotateTransform CenterX="0.5" CenterY="0.5" Angle="-45"/>
                        </Button.LayoutTransform>
                    </Button>
                    
                </Button.Content>
            </Button>
            <Button Content="Click Me" Width="100" Height="30" Margin="0,0,0,10"/>
            <TextBlock Text="Hello, World!" FontSize="16" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
