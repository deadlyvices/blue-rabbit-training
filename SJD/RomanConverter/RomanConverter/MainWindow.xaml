<Window x:Name="RomanConverter" x:Class="RomanConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RomanConverter"
        mc:Ignorable="d"
        Title="Roman to Arabic Converter" Height="174" Width="249"
        TextBlock.FontSize="12" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Width" Value="Auto" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="FontFamily" Value="Calisto MT" />
            <Setter Property="Background" Value="Cornsilk"></Setter>
        </Style>
    </Window.Resources>

        <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="File">
                <MenuItem Header="Exit" Click="Exit_Click"></MenuItem>
            </MenuItem>
        </Menu>
        <TextBlock Grid.Row="1">Enter the Roman Numeral Here</TextBlock>
            <TextBox Grid.Row ="2" x:Name="RomanBox" TextChanged="RomanBox_OnTextChanged" GotFocus="RomanBox_GotFocus"></TextBox>
        <TextBlock Grid.Row ="3" >Enter the Arabic Numeral here</TextBlock>
        <TextBox Grid.Row ="4" x:Name="ArabicBox" TextChanged="ArabicBox_OnTextChanged" FontFamily="Arial" GotFocus="ArabicBox_GotFocus"></TextBox>
        <Button Grid.Row ="5" x:Name="DisplayButton" Content="Display" Click="DisplayButton_Click" HorizontalAlignment="Center" Width="Auto" Height="20" VerticalAlignment="Top"></Button>
    </Grid>
</Window>